{
  "name": "honest-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Honest AI: copied React components for agent and chat interfaces, built on Honest UI.",
  "license": "MIT",
  "homepage": "https://ai.honestui.com",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "registry:index": "node scripts/generate-registry-index.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:site": "npm run generative:standalone && npm run generative:check && npm run lint && npm run prose:check && npm run typecheck && npm run verify:docs && npm run build",
    "test:markdown": "esbuild tests/markdown.test.tsx --bundle --platform=node --format=esm --packages=external --outfile=.next/tests/markdown.test.mjs && node --test .next/tests/markdown.test.mjs",
    "prose:generate": "node scripts/generate-prose-tailwind.mjs",
    "prose:check": "node scripts/generate-prose-tailwind.mjs --check",
    "test:generative": "vitest run",
    "generative:spec": "node scripts/generate-generative-spec.mjs",
    "generative:check": "node scripts/generate-generative-spec.mjs --check",
    "generative:standalone": "node scripts/verify-generative-standalone.mjs"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.53",
    "@base-ui-components/react": "1.0.0-rc.0",
    "@base-ui/react": "1.6.0",
    "@carbon/icons-react": "11.84.0",
    "@hugeicons/core-free-icons": "4.2.3",
    "@hugeicons/react": "1.1.9",
    "@langchain/core": "^1.2.17",
    "@mantine/hooks": "9.4.2",
    "@shikijs/transformers": "4.3.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.14.17",
    "@vercel/analytics": "^2.0.1",
    "ai": "7.0.138",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "6.1.0",
    "eve": "^0.77.0",
    "fumadocs-core": "16.12.1",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.12.1",
    "honestui": "^0.2.0",
    "katex": "0.16.47",
    "motion": "12.42.2",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "openai": "6.22.0",
    "react": "19.2.4",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shadcn": "4.15.0",
    "shiki": "4.3.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
