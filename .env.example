# Copy this file to .env.local for local configuration.
# Restart the app after changing environment variables.

# App URL used for absolute links and metadata.
# Set this to your public site URL when deploying.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only OpenAI key for hosted playground replies in production.
# When configured, gpt-6-luna is the default in the production model picker.
# Get a key at https://platform.openai.com/api-keys
# npm run dev still uses local Ollama. Set this in your deployment's environment.
OPENAI_API_KEY=

# Optional context meter limit. GPT-6 Luna's documented context window:
# https://developers.openai.com/api/docs/models/gpt-6-luna
PLAYGROUND_OPENAI_CONTEXT_TOKENS=1050000

# Optional server-only Google AI Studio key for hosted replies in production.
# Get a key at https://aistudio.google.com/apikey from a free-tier project.
# Leave both provider keys blank to use the visitor's local Ollama instead.
# npm run dev always uses Ollama at http://localhost:11434, even with a key.
GEMINI_API_KEY=

# Optional hosted playground model override; this is the app's default.
# Free-tier availability and quotas: https://ai.google.dev/gemini-api/docs/pricing
PLAYGROUND_GEMINI_MODEL=gemini-3.8-flash

# Optional context window of the hosted model, in tokens. The playground shows
# its context meter only when this is set, measured against this number.
# Default model input limit: https://ai.google.dev/gemini-api/docs/models/gemini-3.8-flash
# Update this value if you change models, or leave blank to hide the meter.
PLAYGROUND_GEMINI_CONTEXT_TOKENS=1048576
